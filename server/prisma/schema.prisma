generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(uuid())
  email         String    @unique
  password      String?
  firstName     String
  lastName      String
  avatar        String?
  provider      String    @default("email")
  providerId    String?
  role          String    @default("user")
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  loginLogs     LoginLog[]
  chatSessions  ChatSession[]
}

model LoginLog {
  id        String   @id @default(uuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  email     String
  ip        String?
  device    String?
  provider  String
  status    String
  createdAt DateTime @default(now())
}

model Message {
  id          String   @id @default(uuid())
  name        String
  email       String
  phone       String?
  projectType String
  budget      String?
  message     String
  status      String   @default("new")
  createdAt   DateTime @default(now())
}

model Subscriber {
  id        String   @id @default(uuid())
  email     String   @unique
  createdAt DateTime @default(now())
}

model PortfolioProject {
  id          String   @id @default(uuid())
  title       String
  slug        String   @unique
  category    String
  description String
  imageUrl    String?
  imageSource String   @default("upload")
  attribution String?
  featured    Boolean  @default(false)
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model PricingPlan {
  id          String   @id @default(uuid())
  name        String
  price       String
  period      String   @default("project")
  description String
  features    String
  highlighted Boolean  @default(false)
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Testimonial {
  id          String   @id @default(uuid())
  name        String
  role        String
  company     String
  quote       String
  rating      Int      @default(5)
  avatarUrl   String?
  imageSource String   @default("upload")
  attribution String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model ChatSession {
  id        String        @id @default(uuid())
  userId    String?
  user      User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdAt DateTime      @default(now())
  messages  ChatMessage[]
}

model ChatMessage {
  id        String      @id @default(uuid())
  sessionId String
  session   ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  role      String
  content   String
  createdAt DateTime    @default(now())
}

model ChatbotConfig {
  id        String   @id @default(uuid())
  key       String   @unique
  value     String
  updatedAt DateTime @default(now())
}

model ClientProject {
  id          String   @id @default(uuid())
  title       String
  clientName  String
  clientEmail String
  status      String   @default("pending")   // pending, in_progress, review, completed, on_hold
  priority    String   @default("medium")     // low, medium, high, urgent
  description String?
  startDate   DateTime?
  deadline    DateTime?
  progress    Int      @default(0)            // 0-100
  budget      String?
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  updates     ProjectUpdate[]
  messages    ClientMessage[]
}

model ProjectUpdate {
  id        String       @id @default(uuid())
  projectId String
  project   ClientProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title     String
  content   String
  author    String       @default("admin")
  createdAt DateTime     @default(now())
}

model PageVisit {
  id         String   @id @default(uuid())
  page       String
  ip         String?
  userAgent  String?
  referrer   String?
  createdAt  DateTime @default(now())
}

model ClientMessage {
  id         String       @id @default(uuid())
  projectId  String?
  project    ClientProject? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  sender     String       // "admin" or "client"
  senderName String
  senderEmail String?
  content    String
  read       Boolean      @default(false)
  createdAt  DateTime     @default(now())
}
