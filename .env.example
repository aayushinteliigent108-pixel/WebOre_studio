# Webore Environment Variables

# Server
PORT=5000
NODE_ENV=development

# Database
# Local dev uses SQLite (file:./dev.db)
# Render uses PostgreSQL (auto-set by render.yaml)
DATABASE_URL="file:./dev.db"

# Session & JWT
SESSION_SECRET=change-this-to-a-random-string
JWT_SECRET=change-this-to-another-random-string

# AI Provider (openai / anthropic / gemini / grok / groq)
AI_PROVIDER=groq
AI_PROVIDER_API_KEY=paste-your-groq-key-here

# Image API (Unsplash / Pexels / Pixabay)
IMAGE_PROVIDER=unsplash
IMAGE_API_KEY=your-image-api-key-here

# Google OAuth 2.0
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Facebook Login
FACEBOOK_APP_ID=your-facebook-app-id
FACEBOOK_APP_SECRET=your-facebook-app-secret

# GitHub OAuth
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret

# Admin (auto-created on first run if no admin exists)
ADMIN_EMAIL=admin@webore.com
ADMIN_PASSWORD=admin@123

# Base URL (no trailing slash)
# Local: http://localhost:5000
# Render: https://webore-studio.onrender.com
BASE_URL=http://localhost:5000

# Email (Resend)
RESEND_API_KEY=your-resend-api-key
RESEND_FROM_EMAIL=onboarding@resend.dev
ADMIN_NOTIFY_EMAIL=webore1007@gmail.com
